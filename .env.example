# Optional. The voice translator starts without a .env; copy this to .env only to change something.
# Every line is commented out with its default.

# Host port (every interface). 127.0.0.1:7860 keeps it to this computer, e.g. behind a reverse proxy.
#VT_PORT=7860
# Vosk model the first start downloads when vosk_models/ is empty (see
# `docker compose run --rm voice-translator python download_vosk_models.py --list`); empty: none.
#VOSK_DEFAULT_MODEL=vosk-model-small-en-us-0.15
# Free the memory of stopped sessions after this many idle seconds; 0 = never.
#IDLE_SESSION_TIMEOUT_SECONDS=0
# Bot token for the "Discord Voice Channel" audio source (DISCORD.md).
#DISCORD_BOT_TOKEN=
# Image name (change it to run a second copy next to this one).
#VT_IMAGE=voice-translator
